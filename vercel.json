{
  "version": 2,
  "regions": ["bom1"],
  "functions": {
    "api/index.ts": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/generate-monthly-fees",
      "schedule": "5 0 * * *"
    }
  ]
}
